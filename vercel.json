{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "composer install --no-dev --optimize-autoloader --no-interaction && npm ci && npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "memory": 1024,
            "maxDuration": 60
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
